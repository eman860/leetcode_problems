public class Main {
    public static void main(String[] args) {
        int n = 1634;
        System.out.println(isArmstrong(n)); 
    }
    
    public static boolean isArmstrong(int n){
        int len = String.valueOf(n).length();
        int sum = 0, temp = n;
        
       
        while (temp > 0) { 
            int digit = temp % 10;
            sum += Math.pow(digit, len);
            temp /= 10;
        }
        
        return sum == n;
    }
}
